# Care / quote chat email notify (off by default; logs only until a provider adapter is added)
# CHAT_EMAIL_NOTIFY=0
# SPARES_PUBLIC_ORIGIN=https://oee360.com

# Per-host Care ticket email. Frame only. Off does not write tickets from inbound mail.
# CARE_TICKET_EMAIL_LIVE=0
# CARE_INBOUND_DOMAIN=tickets.oee360.com

# Session signing (required on Vercel)
AUTH_SECRET=

# Optional hard override for email/password sign-in (overrides Platform → Sign-in when set)
# PASSWORD_LOGIN=1
# PASSWORD_LOGIN=0

# Optional demo buyer password for local e2e only (never committed; migration does not create users)
# SPARES_DEMO_BUYER_PASSWORD=

# Microsoft Entra ID (Sign in with Microsoft) — optional locally
# AZURE_AD_TENANT_ID=organizations
# Use a tenant GUID for single-tenant only; omit or use organizations / common for work/school + personal.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=organizations

# Vercel Blob (required on Vercel)
BLOB_READ_WRITE_TOKEN=

# S3-compatible object storage (required on Vercel)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
